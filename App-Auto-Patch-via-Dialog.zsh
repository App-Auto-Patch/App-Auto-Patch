            UnattendedExitSeconds=86400
        fi
        defaults write "${appAutoPatchLocalPLIST}" UnattendedExitSeconds -int "${UnattendedExitSeconds}"
    elif [[ -n "${UnattendedExitSeconds}" ]] && ! [[ "${UnattendedExitSeconds}" =~ ${REGEX_ANY_WHOLE_NUMBER} ]]; then
